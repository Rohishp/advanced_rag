# Copy to .env and fill in the keys. Every other line shows the default; delete or change it.

# --- Keys ---
OPENAI_API_KEY=                 # required: generation, grading, embeddings
TAVILY_API_KEY=                 # optional: web search for questions outside the documents

# --- Models ---
LLM_MODEL=gpt-6-luna            # pipeline model
LLM_REASONING_EFFORT=none       # none allows temperature 0; low, medium, ... send no temperature
EMBED_MODEL=text-embedding-3-large   # changing it needs a new db_dir (index)
EVAL_MODEL=gpt-6.1-sol          # eval judge, stronger than the pipeline model
EVAL_REASONING_EFFORT=low

# --- Limits and reliability ---
MAX_LLM_CALLS=30                # per question; no new attempt starts once reached
LLM_TIMEOUT_S=120               # seconds per request
EMBED_TIMEOUT_S=60
WEB_TIMEOUT_S=60
API_MAX_RETRIES=3               # retries with backoff on timeouts, 429 and 5xx

# --- Logging, prices ---
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING or ERROR (status lines go to stderr)
MODEL_PRICES=model_prices.yaml  # USD per 1M tokens, for the eval's cost metric

# --- Optional LangSmith tracing (local evals with --local never upload) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default        # LangSmith project name
